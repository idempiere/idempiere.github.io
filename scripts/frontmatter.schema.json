{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Docs page frontmatter",
  "description": "See docs/documentation-standards.md#frontmatter.",
  "type": "object",
  "required": ["description", "tags", "applies_to", "last_reviewed", "owner"],
  "properties": {
    "description": { "type": "string", "minLength": 50, "maxLength": 160 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "applies_to": {
      "type": "string",
      "pattern": "^(all|\\d+(\\.\\d+)?|>=\\d+(\\.\\d+)?|\\d+(\\.\\d+)?-\\d+(\\.\\d+)?)$"
    },
    "last_reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "owner": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
    "deprecated_in": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
    "superseded_by": { "type": "string", "pattern": "^/docs/" },
    "sidebar_position": { "type": "number" },
    "sidebar_label": { "type": "string" }
  }
}
