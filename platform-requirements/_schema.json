{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Platform requirements of one iDempiere release",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requirements"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)*$",
      "description": "Release number, the same as the docs/new-features/v<version> folder name without the v."
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "java": { "$ref": "#/definitions/requirement" },
        "zk": { "$ref": "#/definitions/requirement" },
        "jetty": { "$ref": "#/definitions/requirement" },
        "postgresql": { "$ref": "#/definitions/requirement" },
        "oracle": { "$ref": "#/definitions/requirement" }
      }
    }
  },
  "definitions": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "pattern": "^https?://" }
      }
    }
  }
}
