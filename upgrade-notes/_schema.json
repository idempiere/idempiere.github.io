{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "iDempiere upgrade notes for one release",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "changes"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)*$",
      "description": "Release number, the same as the docs/new-features/v<version> folder name without the v."
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "description": "Platform versions this release needs. Only add values you have a source for.",
      "properties": {
        "java": { "$ref": "#/definitions/requirement" },
        "postgresql": { "$ref": "#/definitions/requirement" },
        "oracle": { "$ref": "#/definitions/requirement" },
        "zk": { "$ref": "#/definitions/requirement" }
      }
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/definitions/change" }
    }
  },
  "definitions": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "pattern": "^https?://" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "code": { "type": "string" },
        "lang": { "type": "string", "enum": ["java", "sql", "bash", "xml", "properties", "text"] }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "area", "audience", "title", "description", "refs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Unique across all files. Used to store checklist ticks, so do not change it once published."
        },
        "type": {
          "type": "string",
          "enum": ["breaking", "incompatible", "disruptive", "action", "deprecation", "requirement"],
          "description": "See upgrade-notes/README.md for what each type means."
        },
        "area": { "type": "string", "minLength": 1 },
        "audience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["developer", "consultant", "admin"] }
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/step" }
        },
        "refs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jira": {
              "type": "array",
              "items": { "type": "string", "pattern": "^IDEMPIERE-\\d+$" }
            },
            "pr": {
              "type": "array",
              "items": { "type": "string", "pattern": "^https?://" }
            }
          },
          "anyOf": [
            { "required": ["jira"], "properties": { "jira": { "type": "array", "minItems": 1 } } },
            { "required": ["pr"], "properties": { "pr": { "type": "array", "minItems": 1 } } }
          ]
        },
        "docs": {
          "type": "string",
          "pattern": "^/",
          "description": "Optional link to a page on this site."
        }
      },
      "if": { "properties": { "type": { "enum": ["breaking", "incompatible", "action"] } } },
      "then": { "required": ["steps"], "properties": { "steps": { "type": "array", "minItems": 1 } } }
    }
  }
}
