// markdownlint rules for docs pages. See docs/documentation-standards.md.
// Rule list: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
{
  "config": {
    "default": true,
    // Heading levels: one # title, no skipped levels.
    "MD001": true,
    // The first # heading is the page title. Ignore a frontmatter title, so
    // older pages that still set one are not flagged for two titles.
    "MD025": { "front_matter_title": "" },
    // The same heading text is fine under different parents.
    "MD024": { "siblings_only": true },
    // One bullet style per page.
    "MD004": { "style": "consistent" },
    // No trailing spaces, except two spaces for a line break.
    "MD009": { "br_spaces": 2 },
    // Tabs are fine inside code blocks.
    "MD010": { "code_blocks": false },
    // Every code block needs a language from this list. Each one is
    // highlighted by the site (Prism, see docusaurus.config.js), except
    // text (plain on purpose) and mermaid (shown as plain code). Names are
    // case-sensitive: sql, not SQL. Add a language here and to Prism
    // additionalLanguages together.
    "MD040": {
      "allowed_languages": [
        "bash", "css", "diff", "groovy", "html", "java", "javascript", "json",
        "markdown", "mermaid", "nginx", "properties", "python", "shell", "sql",
        "text", "xml", "yaml"
      ]
    },
    // Off: long lines, inline HTML and JSX (MDX), bare URLs, table pipe alignment.
    "MD013": false,
    "MD060": false,
    "MD033": false,
    "MD034": false
  },
  "ignores": ["node_modules/**", "build/**", "docs/_templates/**"]
}
